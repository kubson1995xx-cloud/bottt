<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- APEX Desktop: samodzielna aplikacja z silnikiem bota, panelem WWW (127.0.0.1) i serwerem mostów platform. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Apex.Desktop</RootNamespace>
    <AssemblyName>ApexDesktop</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apex.Core\Apex.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
