<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    APEX AI Lab: OSOBNY proces (nie jest ładowany przez APEX Desktop ani cBoty).
    Analizuje wyniki i warunki rynkowe, uruchamia agentów AI (Codex / Claude) w izolowanych kopiach repozytorium,
    weryfikuje zmiany (audyt, kompilacja, testy, backtest) i przygotowuje wydania. Wdrożenie wyłącznie po akceptacji użytkownika.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Apex.AiLab</RootNamespace>
    <AssemblyName>ApexAiLab</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apex.Core\Apex.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
